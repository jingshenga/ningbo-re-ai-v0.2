# Run: cp .env.example .env
# Use separate random secrets; DO NOT commit .env
POSTGRES_DB=rehouse
POSTGRES_USER=rehouse
POSTGRES_PASSWORD=replace-with-long-random-db-password
APP_API_KEY=replace-with-long-random-api-key
# 127.0.0.1 = NAS only. For LAN use NAS local IP (e.g. 192.168.1.10).
# Never directly publish this HTTP port to the public Internet.
API_BIND_IP=127.0.0.1
API_PORT=8787
# Optional: install/run Douyin_TikTok_Download_API v5 separately.
# This endpoint must be reachable FROM the api/worker containers.
# In many setups the easiest method is a shared Docker network or host-gateway mapping.
DTK_BASE_URL=
DTK_API_KEY=

# V0.2: online website fetches are OFF by default.
# Keep FALSE unless source policy/robots and written permission have been reviewed.
# Source-level online_enabled must ALSO be set via policy review API.
ENABLE_ONLINE_COLLECTION=false
# After each attempted web fetch (single worker); >=30 seconds by design.
COLLECTION_MIN_DELAY_SECONDS=30
